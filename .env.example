# ---------------------------------------------------------------------------
# ExamSmasher — API keys
# Copy this file to `.env.local` and fill in your own keys, then restart.
# Both keys are FREE (free tier is plenty for personal use).
# ---------------------------------------------------------------------------

# 1) YouTube Data API v3  (free: 10,000 units/day ≈ 100 video searches)
#    https://console.cloud.google.com/apis/library/youtube.googleapis.com
#    Enable the API -> Credentials -> Create API key
YOUTUBE_API_KEY=

# 2) AI key for syllabus analysis + content matching (pick ONE)
#    Gemini (recommended, free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
#    ...or OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: override the default model names
#   Gemini default  -> gemini-flash-lite-latest (always-current alias)
#   Bigger/slower   -> gemini-flash-latest, gemini-3.8-flash
#   OpenAI default  -> gpt-4o-mini
LLM_MODEL=
